# @react-three/fiber@9.7.0 declares optional peers for expo/react-native support;
# npm's strict resolver chokes on that unrelated peer chain even though we don't
# use it. legacy-peer-deps avoids the ERESOLVE failure in `npm ci`/`npm clean-install`
# (used by Cloudflare Pages) without needing a --legacy-peer-deps flag on the CLI.
legacy-peer-deps=true
